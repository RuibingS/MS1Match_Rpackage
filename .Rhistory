library(RAMClustR)
# patched version that supports XCMSnExp (colData) and legacy xcmsSet (phenoData)
getSampleMetadata_fixed <- function(xcmsObj) {
if (methods::is(xcmsObj, "xcmsSet")) {
pd <- Biobase::pData(Biobase::phenoData(xcmsObj))
return(pd)
}
if (methods::is(xcmsObj, "XCMSnExp")) {
md <- as.data.frame(SummarizedExperiment::colData(xcmsObj))
# RAMClustR wants *something* with rows = samples
if (ncol(md) == 0) {
md <- data.frame(sample_name = basename(xcms::fileNames(xcmsObj)),
stringsAsFactors = FALSE)
}
rownames(md) <- xcms::fileNames(xcmsObj)
return(md)
}
stop("Unsupported xcms object class: ", class(xcmsObj)[1])
}
# Replace the internal function inside RAMClustR namespace
assignInNamespace("getSampleMetadata", getSampleMetadata_fixed, ns = "RAMClustR")
experiment <- defineExperiment(force.skip = TRUE)
RC <- ramclustR(xcmsObj = xdata, ExpDes = experiment)
packageVersion("RAMClustR")
packageVersion("xcms")
class(xdata)
library(RAMClustR)
getSampleMetadata_fixed <- function(xcmsObj) {
# legacy xcmsSet
if (methods::is(xcmsObj, "xcmsSet")) {
return(Biobase::pData(Biobase::phenoData(xcmsObj)))
}
# modern XCMSnExp (xcms >= 3/4): metadata lives in pData (OnDiskMSnExp)
if (methods::is(xcmsObj, "XCMSnExp")) {
md <- tryCatch(MSnbase::pData(xcmsObj), error = function(e) NULL)
# If pData is empty or NULL, create minimal metadata
if (is.null(md) || nrow(md) == 0) {
md <- data.frame(
sample_name = basename(xcms::fileNames(xcmsObj)),
stringsAsFactors = FALSE
)
rownames(md) <- xcms::fileNames(xcmsObj)
return(md)
}
# Ensure it's a plain data.frame
md <- as.data.frame(md)
if (is.null(rownames(md)) || any(rownames(md) == "")) {
rownames(md) <- xcms::fileNames(xcmsObj)
}
return(md)
}
stop("Unsupported xcms object class: ", class(xcmsObj)[1])
}
assignInNamespace("getSampleMetadata", getSampleMetadata_fixed, ns = "RAMClustR")
