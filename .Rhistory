library(xcms)
library(tibble)
library(dplyr)
library(tidyr)
library(MS1Match)
result_StM16 <-readRDS(here::here("inst", "extdata", "result_StM16.rds"))
result_StM16_FT <- as.data.frame(result_StM16[[2]][-which(colnames(result_StM16[[2]])%in%"peakidx" )])%>%
rownames_to_column(var = "feature_name")
result_StM16_FT_int <- as.data.frame(result_StM16[[3]]) %>%
rownames_to_column(var = "feature_name")
# mutate mean intensity column
result_StM16_FT_int_mean <- result_StM16_FT_int %>%
rowwise() %>%
mutate(intensity_mean = mean(dplyr::c_across(matches("mzxml")), na.rm = TRUE)) %>%
ungroup() %>%
data.frame()
result_StM16_FT_join <- result_StM16_FT %>% left_join(.,result_StM16_FT_int_mean, by = "feature_name") # %>% filter(rtmed>=60 & rtmed<=1200 )
# order FT by RT and subset by rt (60 seconds to 1200 seconds )
result_StM16_FT_join_order <- result_StM16_FT_join[order(result_StM16_FT_join$rtmed, decreasing = F), ] %>%
filter(rtmed >= 60 & rtmed <= 1200)
Si16_library <- parse_library_file_parallel_NIST(file_path = here::here("data","StM16_library","Si16.library"),
ionPolarity = "pos",spectrum_type ="MS1")
DirectLibMatch_obj <- createDirectLibMatch(FT = result_StM16_FT_join_order,
compounds_list =  Si16_library,
diff_mz_thr = 0.01,
diff_rt_thr = 5,
ppm = 10)
direct_match_Stm16_res_MS1 <- direct_lib_match(DirectLibMatch_obj)
# convert list to df
direct_match_Stm16_res_MS1_df <- plyr::ldply(direct_match_Stm16_res_MS1, data.frame)
direct_match_Stm16_res_MS1[[1]]
head(direct_match_Stm16_res_MS1_df)
